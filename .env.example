# Required: one persistent Postgres database (Neon or self-hosted)
DATABASE_URL=postgresql://user:password@localhost:5432/lookout
# Read-only GitHub token: repository Metadata/Contents, PRs, Issues, Actions (as applicable)
GITHUB_TOKEN=
GITHUB_OWNER=
LOOKOUT_MAX_REPOS=25
LOOKOUT_STALE_BRANCH_DAYS=14
LOOKOUT_STALE_PR_DAYS=14
LOOKOUT_INCLUDE_FORKS=false

# Optional AI brief generation. No AI calls are made without both values.
AI_GATEWAY_API_KEY=
LOOKOUT_AI_MODEL=

# Scheduled worker frequency. In development, run "npm run sync" instead.
LOOKOUT_POLL_MINUTES=60
# Optional future restriction for authenticated dashboard access
LOOKOUT_DASHBOARD_TOKEN=
